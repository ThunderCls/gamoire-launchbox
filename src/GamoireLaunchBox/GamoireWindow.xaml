<Window x:Class="GamoireLaunchBox.GamoireWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gamoire" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="White" Foreground="#1F1F1F">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- LaunchBox's theme restyles controls app-wide; this window uses its own fixed light palette. -->
        <SolidColorBrush x:Key="Text" Color="#1F1F1F" />
        <SolidColorBrush x:Key="DisabledText" Color="#8A8A8A" />
        <SolidColorBrush x:Key="ButtonFill" Color="#F0F0F0" />
        <SolidColorBrush x:Key="ButtonBorder" Color="#ADADAD" />
        <SolidColorBrush x:Key="HoverFill" Color="#E5F1FB" />
        <SolidColorBrush x:Key="HoverBorder" Color="#0078D7" />
        <SolidColorBrush x:Key="PressedFill" Color="#CCE4F7" />
        <SolidColorBrush x:Key="DisabledFill" Color="#F7F7F7" />
        <SolidColorBrush x:Key="DisabledBorder" Color="#D5D5D5" />
        <!-- Empty styles block LaunchBox's; text inherits Foreground from the window or its control. Button and
             CheckBox labels are explicit TextBlocks: a string label's generated TextBlock skips these resources. -->
        <Style TargetType="TextBlock" />
        <Style TargetType="ScrollViewer" />
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource DisabledText}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource DisabledText}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource ButtonFill}" />
            <Setter Property="BorderBrush" Value="{StaticResource ButtonBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverFill}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource HoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PressedFill}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource HoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource HoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DisabledFill}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DisabledBorder}" />
                                <Setter Property="Foreground" Value="{StaticResource DisabledText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="Server" Margin="0,0,0,4" />
        <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditServer}" Margin="0,0,0,12" />

        <CheckBox IsChecked="{Binding SkipHidden}" Margin="0,0,0,8">
            <TextBlock Text="Skip hidden games (they never leave this PC)" />
        </CheckBox>
        <TextBlock Text="Emulated games sync once you've played, favourited, rated or given them a status, so a big ROM collection doesn't fill your library." TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,16" />

        <TextBlock Text="{Binding State.StatusLine}" TextWrapping="Wrap" Margin="0,0,0,8" />

        <StackPanel Visibility="{Binding State.HasPairingCode, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
            <TextBlock Text="Type this code on the Gamoire page that just opened:" TextWrapping="Wrap" />
            <TextBox Text="{Binding State.PairingCode, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                     FontSize="28" FontFamily="Consolas" Margin="0,12,0,12" />
            <StackPanel Orientation="Horizontal">
                <Button Click="OnCopyCode" Margin="0,0,8,0" Padding="12,4"><TextBlock Text="Copy" /></Button>
                <Button Click="OnOpenBrowser" Padding="12,4"><TextBlock Text="Open in browser" /></Button>
            </StackPanel>
        </StackPanel>

        <TextBlock Text="{Binding State.Notice}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Visibility="{Binding State.HasNotice, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Command="{Binding ConnectCommand}" IsEnabled="{Binding State.CanConnect}" Margin="0,0,8,0" Padding="12,4"><TextBlock Text="Connect" /></Button>
            <Button Command="{Binding DisconnectCommand}" Margin="0,0,8,0" Padding="12,4"><TextBlock Text="Disconnect" /></Button>
            <Button Command="{Binding SyncNowCommand}" IsEnabled="{Binding State.CanSyncNow}" Margin="0,0,8,0" Padding="12,4"><TextBlock Text="Sync now" /></Button>
            <Button Command="{Binding OpenCommand}" Padding="12,4"><TextBlock Text="Open in Gamoire" /></Button>
        </StackPanel>

        <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Opacity="0.7"
                   Text="Disconnect to change the server. Skip hidden games applies to the next sync." />
    </StackPanel>
</Window>
